<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light). -->
    <style name="Base.Theme.SmartNetworkAnalyzerFrontend" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/card_stroke</item>
        
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        
        <!-- Component Overrides -->
        <item name="materialCardViewStyle">@style/Widget.SmartNetwork.Card</item>
        <item name="materialButtonStyle">@style/Widget.SmartNetwork.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.SmartNetwork.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.SmartNetwork.BottomNav</item>
        <item name="android:windowAnimationStyle">@style/SmartNetwork.WindowAnimation</item>
    </style>

    <style name="Theme.SmartNetworkAnalyzerFrontend" parent="Base.Theme.SmartNetworkAnalyzerFrontend" />
</resources>